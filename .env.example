# Velai Backend Configuration
PROJECT_NAME="Velai Campus Gigs"
ENVIRONMENT="development"
DEBUG=True

# Single-college scope
COLLEGE_ID="psg-tech"
COLLEGE_NAME="PSG College of Technology"
COLLEGE_EMAIL_DOMAIN="psgtech.ac.in"

# Database Configuration (PostgreSQL default; supports sqlite+aiosqlite:///./velai.db for local dev)
DATABASE_URL="sqlite+aiosqlite:///./velai.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/velai"

# Security & JWT
SECRET_KEY="change-me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP Auth (Set MOCK_OTP=True in development so OTP is logged to console and fixed to 123456 or generated)
MOCK_OTP=True
DEFAULT_TEST_OTP="123456"

# Notification Rate Limits (Cap: 3 per user per day in Phase 1)
MAX_PUSH_NOTIFICATIONS_PER_DAY=3

# Admin / System Config
ADMIN_EMAIL="admin@psgtech.ac.in"
ADMIN_INITIAL_CODE="change-me"

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","http://localhost:19006","http://localhost:5173","*"]
